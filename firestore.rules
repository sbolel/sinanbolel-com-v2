rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read and write only to their own session document
    match /sessions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to create and read only their own chat documents
    match /chats/{chatId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Preserve chat history after creation.
      allow update, delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid
          && request.resource.data.from == request.auth.uid
          && request.resource.data.keys().hasAll(['body', 'from', 'createdAt'])
          && request.resource.data.keys().hasOnly(['body', 'from', 'createdAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.createdAt is timestamp;
        allow read: if request.auth != null && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
        // Keep messages immutable for the audit trail.
        allow update, delete: if false;
      }
    }

    // Deny access to all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
